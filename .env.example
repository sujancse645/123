NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — NEVER prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
BANK_DATA_ENCRYPTION_KEY=replace_with_a_long_random_secret
BIOMETRIC_DATA_ENCRYPTION_KEY=replace_with_a_different_long_random_secret

# WebAuthn must match the exact browser hostname/origin (HTTPS outside localhost)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# Set both true only after 20260906100000_peoplepay360_biometric_contract_payroll.sql is applied.
NEXT_PUBLIC_BIOMETRICS_ENABLED=false
NEXT_PUBLIC_CONTRACT_PAYROLL_GUARDS_ENABLED=false
# Presentation only. Keep false in production.
NEXT_PUBLIC_PRESENTATION_BIOMETRIC_BYPASS=false

# Demo seeding protection
ALLOW_DEMO_SEED=false
DEMO_COMPANY_NAME=PeoplePay360 Demo Private Limited
DEMO_DEFAULT_PASSWORD=PeoplePay@360

# Email integration
EMAIL_PROVIDER=console
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_COMPANY_ID=00000000-0000-0000-0000-000000000001
